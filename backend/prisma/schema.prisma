// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organizacao {
  id       String   @id @default(uuid())
  nome     String
  criadoEm DateTime @default(now()) @map("criado_em")

  usuarios Usuario[]
  clientes Cliente[]
  maquinas Maquina[]
  materiais Material[]
  servicosAdicionais ServicoAdicional[]
  pedidos            Pedido[]
  tokensAcesso       TokenAcesso[]

  @@map("organizacao")
}

enum Perfil {
  ADMINISTRADOR
  GESTOR
  OPERADOR
  CLIENTE
}

model Usuario {
  id            String   @id @default(uuid())
  organizacaoId String   @map("organizacao_id")
  nome          String
  email         String
  senhaHash     String   @map("senha_hash")
  perfil        Perfil
  ativo         Boolean  @default(true)
  clienteId     String?  @map("cliente_id")
  criadoEm      DateTime @default(now()) @map("criado_em")

  organizacao  Organizacao   @relation(fields: [organizacaoId], references: [id])
  cliente      Cliente?      @relation(fields: [organizacaoId, clienteId], references: [organizacaoId, id], onDelete: Restrict)
  tokensAcesso TokenAcesso[]

  @@unique([organizacaoId, email])
  @@map("usuario")
}

enum TipoTokenAcesso {
  CONVITE
  RECUPERACAO
}

// Link de uso unico para criar ou trocar a senha. Guarda so o hash do token.
model TokenAcesso {
  id            String          @id @default(uuid())
  organizacaoId String          @map("organizacao_id")
  usuarioId     String          @map("usuario_id")
  tipo          TipoTokenAcesso
  tokenHash     String          @unique @map("token_hash")
  expiraEm      DateTime        @map("expira_em")
  usadoEm       DateTime?       @map("usado_em")
  criadoEm      DateTime        @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@map("token_acesso")
}

model Cliente {
  id            String   @id @default(uuid())
  organizacaoId String   @map("organizacao_id")
  nome          String
  cpfCnpj       String?  @map("cpf_cnpj")
  contato       String?
  endereco      String?
  criadoEm      DateTime @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  pedidos     Pedido[]
  usuarios    Usuario[]

  @@unique([organizacaoId, id])
  @@map("cliente")
}

enum StatusMaquina {
  ATIVA
  EM_MANUTENCAO
  INATIVA
}

model Maquina {
  id            String        @id @default(uuid())
  organizacaoId String        @map("organizacao_id")
  nome          String
  tipo          String
  status        StatusMaquina @default(ATIVA)
  criadoEm      DateTime      @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  pedidos     Pedido[]

  @@unique([organizacaoId, id])
  @@map("maquina")
}

model Material {
  id            String   @id @default(uuid())
  organizacaoId String   @map("organizacao_id")
  tipo          String
  precoM2       Decimal  @map("preco_m2") @db.Decimal(10, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  pedidos     Pedido[]

  @@unique([organizacaoId, id])
  @@map("material")
}

model ServicoAdicional {
  id             String   @id @default(uuid())
  organizacaoId  String   @map("organizacao_id")
  descricao      String
  valorPadrao    Decimal  @map("valor_padrao") @db.Decimal(10, 2)
  criadoEm       DateTime @default(now()) @map("criado_em")

  organizacao    Organizacao     @relation(fields: [organizacaoId], references: [id])
  pedidoServicos PedidoServico[]

  @@map("servico_adicional")
}

enum StatusPedido {
  AGUARDANDO_VALIDACAO
  NA_FILA
  EM_PRODUCAO
  CONCLUIDO
  RETRABALHO
  FATURADO
  REJEITADO
}

enum FormaPagamento {
  A_VISTA
  EM_CONTA
}

model Pedido {
  id             String         @id @default(uuid())
  organizacaoId  String         @map("organizacao_id")
  clienteId      String         @map("cliente_id")
  materialId     String         @map("material_id")
  maquinaId      String?        @map("maquina_id")
  status         StatusPedido   @default(AGUARDANDO_VALIDACAO)
  largura        Decimal        @db.Decimal(10, 3)
  altura         Decimal        @db.Decimal(10, 3)
  quantidade     Int
  acabamento     String
  arquivoUrl     String         @map("arquivo_url")
  formaPagamento FormaPagamento @default(A_VISTA) @map("forma_pagamento")
  prazoEntrega   DateTime       @map("prazo_entrega")
  metragemTotal  Decimal        @map("metragem_total") @db.Decimal(10, 2)
  valorBase      Decimal        @map("valor_base") @db.Decimal(10, 2)
  valorTotal     Decimal        @map("valor_total") @db.Decimal(10, 2)
  observacaoTecnica String?     @map("observacao_tecnica")
  motivoRejeicao String?        @map("motivo_rejeicao")
  posicaoFila    Int?           @map("posicao_fila")
  iniciadoEm     DateTime?      @map("iniciado_em")
  concluidoEm    DateTime?      @map("concluido_em")
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em")

  organizacao      Organizacao        @relation(fields: [organizacaoId], references: [id])
  cliente          Cliente            @relation(fields: [organizacaoId, clienteId], references: [organizacaoId, id])
  material         Material           @relation(fields: [organizacaoId, materialId], references: [organizacaoId, id])
  maquina          Maquina?           @relation(fields: [organizacaoId, maquinaId], references: [organizacaoId, id], onDelete: Restrict)
  pedidoServicos   PedidoServico[]
  retrabalhos      Retrabalho[]
  ajustesValor     AjusteValor[]

  @@map("pedido")
}

model PedidoServico {
  id                 String   @id @default(uuid())
  pedidoId           String   @map("pedido_id")
  servicoAdicionalId String   @map("servico_adicional_id")
  quantidade         Int
  valorUnitario      Decimal  @map("valor_unitario") @db.Decimal(10, 2)

  pedido           Pedido           @relation(fields: [pedidoId], references: [id])
  servicoAdicional ServicoAdicional @relation(fields: [servicoAdicionalId], references: [id])

  @@map("pedido_servico")
}

model Retrabalho {
  id               String   @id @default(uuid())
  pedidoId         String   @map("pedido_id")
  motivo           String
  custoOperacional Decimal      @map("custo_operacional") @db.Decimal(10, 2)
  statusOrigem     StatusPedido @map("status_origem")
  criadoEm         DateTime     @default(now()) @map("criado_em")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("retrabalho")
}

model AjusteValor {
  id          String   @id @default(uuid())
  pedidoId    String   @map("pedido_id")
  descricao   String
  valor       Decimal  @db.Decimal(10, 2)
  criadoEm    DateTime @default(now()) @map("criado_em")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("ajuste_valor")
}
