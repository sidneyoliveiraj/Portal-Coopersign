// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organizacao {
  id       String   @id @default(uuid())
  nome     String
  criadoEm DateTime @default(now()) @map("criado_em")

  usuarios Usuario[]
  clientes Cliente[]
  maquinas Maquina[]
  materiais Material[]
  servicosAdicionais ServicoAdicional[]
  pedidos            Pedido[]

  @@map("organizacao")
}

enum Perfil {
  ADMINISTRADOR
  GESTOR
  OPERADOR
  CLIENTE
}

model Usuario {
  id            String   @id @default(uuid())
  organizacaoId String   @map("organizacao_id")
  nome          String
  email         String   @unique
  senhaHash     String   @map("senha_hash")
  perfil        Perfil
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])

  @@map("usuario")
}

model Cliente {
  id            String   @id @default(uuid())
  organizacaoId String   @map("organizacao_id")
  nome          String
  cpfCnpj       String?  @map("cpf_cnpj")
  contato       String?
  endereco      String?
  criadoEm      DateTime @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  pedidos     Pedido[]

  @@map("cliente")
}

enum StatusMaquina {
  ATIVA
  EM_MANUTENCAO
  INATIVA
}

model Maquina {
  id            String        @id @default(uuid())
  organizacaoId String        @map("organizacao_id")
  nome          String
  tipo          String
  status        StatusMaquina @default(ATIVA)
  criadoEm      DateTime      @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  pedidos     Pedido[]

  @@map("maquina")
}

model Material {
  id            String   @id @default(uuid())
  organizacaoId String   @map("organizacao_id")
  tipo          String
  precoM2       Decimal  @map("preco_m2") @db.Decimal(10, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  pedidos     Pedido[]

  @@map("material")
}

model ServicoAdicional {
  id             String   @id @default(uuid())
  organizacaoId  String   @map("organizacao_id")
  descricao      String
  valorPadrao    Decimal  @map("valor_padrao") @db.Decimal(10, 2)
  criadoEm       DateTime @default(now()) @map("criado_em")

  organizacao    Organizacao     @relation(fields: [organizacaoId], references: [id])
  pedidoServicos PedidoServico[]

  @@map("servico_adicional")
}

enum StatusPedido {
  RASCUNHO
  AGUARDANDO_VALIDACAO
  EM_PRODUCAO
  CONCLUIDO
  FATURADO
  REJEITADO
}

enum FormaPagamento {
  A_VISTA
  EM_CONTA
}

model Pedido {
  id             String         @id @default(uuid())
  organizacaoId  String         @map("organizacao_id")
  clienteId      String         @map("cliente_id")
  materialId     String         @map("material_id")
  maquinaId      String?        @map("maquina_id")
  status         StatusPedido   @default(RASCUNHO)
  largura        Decimal        @db.Decimal(10, 2)
  altura         Decimal        @db.Decimal(10, 2)
  quantidade     Int
  acabamento     String
  arquivoUrl     String         @map("arquivo_url")
  formaPagamento FormaPagamento @default(A_VISTA) @map("forma_pagamento")
  prazoEntrega   DateTime       @map("prazo_entrega")
  metragemTotal  Decimal        @map("metragem_total") @db.Decimal(10, 2)
  valorBase      Decimal        @map("valor_base") @db.Decimal(10, 2)
  valorTotal     Decimal        @map("valor_total") @db.Decimal(10, 2)
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")

  organizacao      Organizacao        @relation(fields: [organizacaoId], references: [id])
  cliente          Cliente            @relation(fields: [clienteId], references: [id])
  material         Material           @relation(fields: [materialId], references: [id])
  maquina          Maquina?           @relation(fields: [maquinaId], references: [id])
  pedidoServicos   PedidoServico[]
  retrabalhos      Retrabalho[]
  ajustesValor     AjusteValor[]

  @@map("pedido")
}

model PedidoServico {
  id                 String   @id @default(uuid())
  pedidoId           String   @map("pedido_id")
  servicoAdicionalId String   @map("servico_adicional_id")
  quantidade         Int
  valorUnitario      Decimal  @map("valor_unitario") @db.Decimal(10, 2)

  pedido           Pedido           @relation(fields: [pedidoId], references: [id])
  servicoAdicional ServicoAdicional @relation(fields: [servicoAdicionalId], references: [id])

  @@map("pedido_servico")
}

model Retrabalho {
  id               String   @id @default(uuid())
  pedidoId         String   @map("pedido_id")
  motivo           String
  custoOperacional Decimal  @map("custo_operacional") @db.Decimal(10, 2)
  garantia         Boolean  @default(false)
  criadoEm         DateTime @default(now()) @map("criado_em")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("retrabalho")
}

model AjusteValor {
  id          String   @id @default(uuid())
  pedidoId    String   @map("pedido_id")
  descricao   String
  valor       Decimal  @db.Decimal(10, 2)
  criadoEm    DateTime @default(now()) @map("criado_em")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("ajuste_valor")
}
