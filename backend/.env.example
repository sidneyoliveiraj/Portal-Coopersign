DATABASE_URL="postgresql://coopersign:coopersign@localhost:5432/coopersign?schema=public"

# Origens liberadas no CORS, separadas por virgula
CORS_ORIGIN="http://localhost:5173"

# Organizacao que recebe os cadastros publicos de clientes
ORGANIZACAO_CADASTRO_ID="org-coopersign-dev"

# Segredo do token JWT (obrigatorio; em producao vem dos secrets do GitHub)
JWT_SECRET="troque-por-um-segredo-longo"

# Endereco do site, usado nos links de convite e de nova senha
APP_URL="http://localhost:5173"

# E-mail: sem SMTP_HOST o link aparece no terminal do backend
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USUARIO=""
SMTP_SENHA=""
SMTP_REMETENTE=""
