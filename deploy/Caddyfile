# Unica porta publica. O Caddy emite e renova o certificado HTTPS sozinho.
{$DOMINIO} {
	encode gzip

	# Cabecalhos de seguranca para todo o site (o HSTS faz o navegador sempre usar HTTPS).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
